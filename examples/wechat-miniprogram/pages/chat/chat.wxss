.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8fafc;
}

.messages {
  flex: 1;
  height: calc(100vh - 160rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

.message {
  display: flex;
  margin-bottom: 20rpx;
}

.message.user {
  justify-content: flex-end;
}

.message.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

.user .bubble {
  color: #ffffff;
  background: #2563eb;
  border-bottom-right-radius: 4rpx;
}

.assistant .bubble {
  color: #0f172a;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-bottom-left-radius: 4rpx;
}

.status {
  padding: 12rpx 4rpx 32rpx;
  color: #64748b;
  font-size: 24rpx;
}

.composer {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
}

.input {
  flex: 1;
  min-height: 72rpx;
  max-height: 220rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.5;
}

.send {
  width: 144rpx;
  margin: 0;
}
